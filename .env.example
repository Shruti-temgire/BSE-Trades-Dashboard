# BSE Trades Dashboard - configuration
# Copy to .env and adjust:   Copy-Item .env.example .env
# Every value below is a safe local-development default. No secrets are needed.

# ---------------------------------------------------------------- Database
# Relative paths are resolved from the project root.
DATABASE_PATH=database/trades.db

# ---------------------------------------------------------------- Mock BSE API (GET /getTrades)
# Number of deterministic sample trades and the random seed that generates them.
MOCK_TOTAL_TRADES=5000
MOCK_SEED=42

# Total artificial time for pulling ALL trades, in seconds. It is split evenly over the pages.
#   20  -> development: a full pull takes ~20 s (each 100-trade page waits 0.4 s)
#   900 -> realistic 15-minute pull (each 100-trade page waits 18 s, below the 30 s network limit)
MOCK_FULL_PULL_SECONDS=20

# Make this page fail with HTTP 503 to demonstrate error handling (0 = disabled).
MOCK_FAIL_PAGE=0

# ---------------------------------------------------------------- Worker
MOCK_BSE_BASE_URL=http://127.0.0.1:8000
# Trades per request. Keep MOCK_FULL_PULL_SECONDS * WORKER_BATCH_SIZE / MOCK_TOTAL_TRADES < 30.
WORKER_BATCH_SIZE=100
WORKER_POLL_SECONDS=1
WORKER_MAX_RETRIES=3
WORKER_RETRY_BACKOFF_SECONDS=2
WORKER_REQUEST_TIMEOUT_SECONDS=28
# A 'running' job whose heartbeat is older than this is assumed abandoned and re-queued.
WORKER_STALE_SECONDS=120

# ---------------------------------------------------------------- Server-Sent Events
# Each SSE connection is closed by the server before the network's 30 s limit;
# the browser reconnects automatically (after SSE_RETRY_MS) and resumes via Last-Event-ID.
SSE_MAX_CONNECTION_SECONDS=25
SSE_POLL_SECONDS=0.5
SSE_PING_SECONDS=10
SSE_RETRY_MS=1000
EVENT_RETENTION=5000

# Allowed browser origins if the frontend calls the API directly (Vite's proxy doesn't need this).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
